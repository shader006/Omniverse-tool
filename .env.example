# ==============================================================================
# Omniverse-tool Environment Configuration Example
# Copy this file to '.env' and adjust the values according to your machine setup.
# NOTE: The '.env' file contains sensitive information and is IGNORED by git.
# ==============================================================================

# --- Conda Environment Configuration ---
CONDA_ENV_NAME=omniverse

# --- Storage & Download Directories ---
# DOWNLOAD_DIR=/path/to/Omniverse-tool/downloads

# --- AI Remote Workers & Auto-Failover Configuration ---
# WORKER_WHISPER_URL=http://pail:8002
# WORKER_WHISPER_FALLBACK_URL=http://tasks.worker-whisper:8002
# WORKER_RMBG_URL=http://pail:8003
# WORKER_RMBG_FALLBACK_URL=http://tasks.worker-rmbg:8003
# WORKER_WHISPER_REPLICAS=1
# WORKER_RMBG_REPLICAS=1

# --- Cloudflare Tunnel (Optional: For public domain exposure) ---
# CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- Docker Swarm & Orchestration (Optional) ---
# WORKSPACE_DIR=/path/to/Omniverse-tool

# --- Telemetry & Observability (Optional) ---
# HIAI_OBSERVE_URL=http://172.17.0.1:8001
# HIAI_OBSERVE_API_KEY=your_api_key_here
